{
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react",
    "paths": {
      "*": ["../node_modules/*"],
      "react-native-sqlcipher-storage/main": [
        "../node_modules/react-native-sqlcipher-storage/electron/main"
      ],
      "react-native-sqlcipher-storage/preload": [
        "../node_modules/react-native-sqlcipher-storage/electron/preload"
      ]
    }
  },
  "include": ["**/*"]
}
